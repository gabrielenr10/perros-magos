---
type ButtonVariant = 'primary' | 'outline-light' | 'outline-dark'

interface Props {
  href?: string
  variant?: ButtonVariant
  target?: string
  rel?: string
  class?: string
}

const { href, variant = 'primary', target, rel, class: className } = Astro.props

const variants: Record<ButtonVariant, string> = {
  primary: 'bg-flame-600 text-white hover:bg-flame-700',
  'outline-light': 'border border-white/50 text-cream-50 hover:bg-white/10',
  'outline-dark': 'border border-ink-900/25 text-ink-900 hover:bg-ink-900/5',
}

const classes = [
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-colors focus-visible:transition-none motion-reduce:transition-none',
  variants[variant],
  className,
]
  .filter(Boolean)
  .join(' ')
---

{href ? (
  <a href={href} target={target} rel={rel} class={classes}>
    <slot />
  </a>
) : (
  <button type="button" class={classes}>
    <slot />
  </button>
)}
