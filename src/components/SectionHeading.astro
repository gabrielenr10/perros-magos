---
type EyebrowTone = 'flame' | 'forest'

interface Props {
  id?: string
  eyebrow?: string
  eyebrowTone?: EyebrowTone
  title: string
  description?: string
  class?: string
}

const {
  id,
  eyebrow,
  eyebrowTone = 'flame',
  title,
  description,
  class: className,
} = Astro.props

const eyebrowTones: Record<EyebrowTone, string> = {
  flame: 'text-flame-700',
  forest: 'text-forest-600',
}
---

<div class:list={['text-center', className]}>
  {eyebrow && (
    <p
      class:list={[
        'text-xs font-bold tracking-[0.18em] uppercase',
        eyebrowTones[eyebrowTone],
      ]}
    >
      {eyebrow}
    </p>
  )}

  <h2
    id={id}
    class:list={[
      'font-display text-3xl font-extrabold tracking-tight text-balance text-ink-900 sm:text-4xl',
      eyebrow && 'mt-3',
    ]}
  >
    {title}
  </h2>

  {description && (
    <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-pretty text-ink-700">
      {description}
    </p>
  )}
</div>
