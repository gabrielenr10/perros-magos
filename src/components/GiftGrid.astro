---
import GiftCard from './GiftCard.astro'
import type { Gift } from '../data/gifts'

interface Props {
  gifts: Gift[]
  class?: string
}

const { gifts, class: className } = Astro.props
---

<div
  class:list={[
    'grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3',
    className,
  ]}
  id="gift-grid"
  data-gift-grid
>
  {gifts.map((gift) => (
    <GiftCard gift={gift} />
  ))}
</div>
