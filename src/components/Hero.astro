---
import { Image } from 'astro:assets'
import Button from '../components/Button.astro'
import logo from '../assets/rivanimal-logo.png'

const snowflakePattern = [
  'text-[9px] opacity-30',
  'text-[6px] opacity-20',
  'text-[11px] opacity-40',
  'text-[7px] opacity-25',
  'text-[13px] opacity-50',
]

const snowflakes = Array.from(
  { length: 19 },
  (_, index) => snowflakePattern[index % snowflakePattern.length]
)
---

<section id="inicio" class="overflow-hidden bg-forest-600 text-cream-50">
  <div class="page-shell">
    <div
      class="mx-auto flex w-full max-w-xl justify-between pt-6 text-forest-100 sm:pt-8"
      aria-hidden="true"
    >
      {snowflakes.map((flake) => (
        <span class={flake}>❄</span>
      ))}
    </div>

    <div class="flex flex-col items-center pt-6 pb-10 text-center sm:pt-8 sm:pb-12">
      <!-- TODO: replace with the official logo asset. -->
      <Image
        src={logo}
        alt="Rivanimal"
        width={112}
        height={91}
        densities={[1, 2]}
        loading="eager"
        class="h-20 w-auto"
      />

      <p class="mt-5 text-[11px] font-bold tracking-[0.24em] text-gold-200 uppercase">
        Navidad solidaria · Catálogo de regalos
      </p>

      <h1 class="mt-3 max-w-3xl font-display text-4xl leading-[1.1] font-extrabold tracking-tight text-balance sm:text-5xl">
        Dale la Navidad perfecta a nuestros perritos
      </h1>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-cream-50/90">
        Este año, regala amor con cuatro patas. Cada compra a través de este
        catálogo ayuda directamente a los perros del refugio Rivanimal a tener
        una Navidad más cálida y feliz.
      </p>

      <div class="mt-7 flex flex-col items-center gap-3 sm:flex-row">
        <Button href="#catalogo">
          Ver todos los regalos
          <span aria-hidden="true">→</span>
        </Button>
        <Button href="#como-funciona" variant="outline-light">
          ¿Cómo funciona?
        </Button>
      </div>
    </div>

    <div
      class="mx-auto flex w-full max-w-xl justify-between pb-6 text-forest-100 sm:pb-8"
      aria-hidden="true"
    >
      {snowflakes.map((flake) => (
        <span class={flake}>❄</span>
      ))}
    </div>
  </div>
</section>
