---
import Button from './Button.astro'

// TODO: replace with the real contact address.
const contactHref = 'mailto:contacto@rivanimal.example'
// TODO: replace with the real "Saber más" destination.
const moreHref = '#como-funciona'
---

<section class="pb-12 sm:pb-16">
  <div class="page-shell text-center">
    <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance text-ink-900 sm:text-4xl">
      ¿Listo para hacer feliz a un peludo?
    </h2>

    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-700">
      Cada gesto de amor importa. Si no puedes hacer ningún regalo físico,
      también puedes hacerte Padrino o Voluntario para apoyarnos y ayudar a los
      peludos.
    </p>

    <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href={moreHref} class="focus-visible:outline-ink-900">
        Saber más
      </Button>
      <Button href={contactHref} variant="outline-dark">
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5.5" width="18" height="13" rx="2"></rect>
          <path d="m4 7 8 5.5L20 7"></path>
        </svg>
        Contactar con Rivanimal
      </Button>
    </div>
  </div>
</section>
