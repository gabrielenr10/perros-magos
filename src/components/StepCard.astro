---
type StepTone = 'forest' | 'berry' | 'gold'

interface Props {
  step: number
  title: string
  description: string
  tone?: StepTone
}

const { step, title, description, tone = 'forest' } = Astro.props

const tones: Record<StepTone, string> = {
  forest: 'bg-forest-600 text-white',
  berry: 'bg-berry-600 text-white',
  gold: 'bg-gold-400 text-ink-900',
}
---

<article class="flex h-full flex-col items-center rounded-card border border-ink-900/5 bg-white px-6 py-8 text-center shadow-card">
  <div
    class:list={[
      'flex size-12 items-center justify-center rounded-full',
      tones[tone],
    ]}
  >
    <slot name="icon" />
  </div>

  <span class="mt-3 rounded-full bg-blush-50 px-2.5 py-1 text-[11px] font-bold text-flame-700">
    Paso {step}
  </span>

  <h3 class="mt-3 font-display text-lg font-extrabold text-ink-900">{title}</h3>

  <p class="mt-2 text-sm leading-relaxed text-ink-700">{description}</p>
</article>
